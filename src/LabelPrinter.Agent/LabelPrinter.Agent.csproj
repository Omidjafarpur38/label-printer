<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console front end: every interactive command, and `run` in the foreground. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>LabelPrinterAgent</AssemblyName>
    <RootNamespace>LabelPrinter.Agent</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>Flow Poshak</Company>
    <Product>Label Printer Agent</Product>
    <Description>Windows print agent for the Flow Poshak production ERP (experimental)</Description>
    <Copyright>Copyright (c) Flow Poshak</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <DebugType>none</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Ui\*" LogicalName="ui/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LabelPrinter.Agent.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LabelPrinter.Agent.Core\LabelPrinter.Agent.Core.csproj" />
  </ItemGroup>
</Project>
