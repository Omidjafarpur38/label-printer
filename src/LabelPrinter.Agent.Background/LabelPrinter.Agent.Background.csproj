<Project Sdk="Microsoft.NET.Sdk">
  <!-- Same sources as the console front end, built without a console window. It only runs the agent loop
       and is what opt-in autostart launches. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LabelPrinterAgentBg</AssemblyName>
    <RootNamespace>LabelPrinter.Agent</RootNamespace>
    <DefineConstants>$(DefineConstants);BACKGROUND</DefineConstants>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>..\LabelPrinter.Agent\app.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>..\LabelPrinter.Agent\app.manifest</ApplicationManifest>
    <Company>Flow Poshak</Company>
    <Product>Label Printer Agent</Product>
    <Description>Windows print agent for the Flow Poshak production ERP (experimental)</Description>
    <Copyright>Copyright (c) Flow Poshak</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <DebugType>none</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\LabelPrinter.Agent\**\*.cs" Exclude="..\LabelPrinter.Agent\bin\**;..\LabelPrinter.Agent\obj\**" LinkBase="Shared" />
    <EmbeddedResource Include="..\LabelPrinter.Agent\Ui\*" LogicalName="ui/%(Filename)%(Extension)" />
    <ProjectReference Include="..\LabelPrinter.Agent.Core\LabelPrinter.Agent.Core.csproj" />
  </ItemGroup>
</Project>
